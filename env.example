# Obrigatório
ANTHROPIC_API_KEY=sk-ant-...
# Recomendado: só utilizadores com sessão na sua app (Firebase) podem usar a IA
FIREBASE_PROJECT_ID=o-id-do-seu-projeto-firebase
# Origens autorizadas (a URL onde publica a app), separadas por vírgula
ALLOWED_ORIGINS=https://o-seu-site.com
# Opcionais
MODEL=claude-haiku-4-5-20251001
PORT=8787
RATE_PER_HOUR=30
DAILY_CAP=2000
# Só para testes locais, sem Firebase (NÃO usar em produção)
ALLOW_ANON=false
